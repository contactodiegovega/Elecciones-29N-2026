# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Datos crudos grandes (se conservan localmente, no en git si superan 50 MB)
data/raw/*
!data/raw/.gitkeep

# Cachés y temporales
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
*.log

# Frontend
web/node_modules/
web/.next/
web/.next-*/
web/out/
web/out-before-redesign/
web/*.tsbuildinfo
web/test-results/
web/playwright-report/

# Secretos
.env
*.key
secrets*.json
.vercel/
.env.local
.env.*.local

# VS Code (opcional, se permite settings locales)
.vscode/*
!.vscode/extensions.json
web/next-env.d.ts
