{
  "name": "observatorio-electoral-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run check:data",
    "check:data": "node scripts/check-data.cjs",
    "prepare:data": "node scripts/prepare-data.cjs",
    "build": "next build",
    "build:review": "node scripts/build-review.cjs",
    "build:public": "npm run check:release && npm run build",
    "check:release": "node scripts/check-data.cjs --release",
    "start": "next start",
    "preview": "python scripts/preview.py",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint app components lib"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "lucide-react": "^0.469.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "next": { "postcss": "^8.5.23" },
    "@typescript-eslint/typescript-estree": { "minimatch": "^11.0.1" }
  }
}
